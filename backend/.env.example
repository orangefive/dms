# ===== 基础 =====
NODE_ENV=development
PORT=3000

# ===== 数据库 =====
# 本地开发（Docker 内使用 mysql://dms:password@mysql:3306/dms_dev）
DATABASE_URL=mysql://root@127.0.0.1:3306/dms_dev

# ===== JWT =====
JWT_SECRET=please_change_me_jwt_secret_32chars_min
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=please_change_me_refresh_secret_32chars_min
JWT_REFRESH_EXPIRES_IN=7d

# ===== API Key =====
API_KEY_SECRET=please_change_me_api_key_secret

# ===== 业务 =====
BATCH_INSERT_LIMIT=1000
# Excel 导入单次行数上限（最大 5000）
EXCEL_IMPORT_LIMIT=1000
# 接口限流（次/分钟/IP），生产建议 300
THROTTLE_LIMIT=300
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# ===== Cookie =====
# 生产环境（HTTPS）设为 true
COOKIE_SECURE=false

# ===== 反向代理 =====
# 部署在 Nginx / 负载均衡之后时设为 true，用于取 X-Forwarded-For 中的真实客户端 IP
TRUST_PROXY=false

# ===== Swagger =====
# 关闭时 /api/docs 不注册；默认关闭，需要时显式打开
SWAGGER_ENABLED=true

# 注意：NODE_ENV=production 时 JWT_SECRET / JWT_REFRESH_SECRET / API_KEY_SECRET
# 会做强度校验（长度 >= 32、不得为示例占位值、三者互不相同），不满足将直接启动失败。
