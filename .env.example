# ===== Docker Compose 环境变量（cp .env.example .env 后修改） =====
#
# 重要：后端在生产模式下对密钥做强制校验（fail fast）。
# 下面 3 个密钥以 please_change_me 开头的占位值会被直接拒绝启动，
# 且要求长度 >= 32、三者互不相同。生成方式：
#   openssl rand -hex 32

# MySQL
MYSQL_ROOT_PASSWORD=dms_root_change_me
MYSQL_PASSWORD=dms_password_change_me

# JWT（生产环境务必改为随机长字符串）
JWT_SECRET=please_change_me_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=please_change_me_refresh_secret_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# API Key 加盐
API_KEY_SECRET=please_change_me_api_key_secret

# 业务
BATCH_INSERT_LIMIT=1000
CORS_ORIGIN=http://localhost:8080

# 若通过 HTTPS 反向代理对外提供服务，请设为 true
COOKIE_SECURE=false

# 位于反向代理之后时为 true，用于取 X-Forwarded-For 作为审计日志的真实 IP。
# docker-compose.yml 已内置 TRUST_PROXY=true；直连 Node 端口时应为 false。
# TRUST_PROXY=true

# 接口文档（/api/docs）。对公网暴露前建议改为 false
SWAGGER_ENABLED=true

# 如需连接公司已有 MySQL，在 docker-compose.yml 中修改 DATABASE_URL
# 示例：mysql://user:password@your-mysql-host:3306/dms_dev
